{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gbf",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": true
  }
}
